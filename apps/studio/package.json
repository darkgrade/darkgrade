{
    "name": "@darkgrade/studio",
    "productName": "Darkgrade Studio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Darkgrade Studio \u2014 desktop camera control with local live transcription",
    "main": "out/main/index.js",
    "scripts": {
        "build:slate": "bun run --cwd ../../packages/slate build",
        "ensure:electron": "node scripts/ensure-electron.mjs",
        "ensure:llama-server": "bun scripts/download-llama-server.ts",
        "build:native": "node scripts/build-native.mjs",
        "dev": "bun run ensure:electron && bun run ensure:llama-server && bun run build:slate && bun run build:native && electron-vite dev",
        "start": "bun run dev",
        "build": "bun run ensure:llama-server && bun run build:slate && bun run build:native && electron-vite build",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "test": "vitest run",
        "e2e": "bun e2e/run-each-camera.ts",
        "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
        "lint": "eslint . --ext .ts,.tsx",
        "format": "prettier --write .",
        "package": "bun run build && electron-builder --mac"
    },
    "dependencies": {
        "@darkgrade/slate": "workspace:*",
        "@kevinschaich/components": "0.7.0",
        "@modelcontextprotocol/node": "2.1.2",
        "@modelcontextprotocol/server": "2.4.0",
        "lucide-react": "^1.71.0",
        "onnxruntime-web": "1.31.1",
        "react": "^19",
        "react-dom": "^19",
        "usb": "^2.11.0",
        "usb-rs": "npm:usb@3.2.1",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/w3c-web-usb": "^1.0.13",
        "@vitejs/plugin-react": "^5.0.0",
        "@webgpu/types": "0.1.74",
        "electron": "^43.1.0",
        "electron-builder": "^26.18.0",
        "electron-vite": "^5.0.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.9.2",
        "vite": "^7.3.7",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=22.18"
    },
    "trustedDependencies": [
        "electron",
        "electron-builder",
        "esbuild"
    ]
}
