{
    "name": "@darkgrade/contribution-collector",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "imports": {
        "#collector/*": "./dist/*.js"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test tests/*.test.ts",
        "start": "node dist/main.js",
        "cleanup": "node dist/operations.js cleanup",
        "review": "node dist/operations.js review",
        "export:matrix": "node dist/operations.js export",
        "smoke": "node dist/smoke.js",
        "test:postgres": "npm run build && node --test tests/postgres.test.ts"
    },
    "dependencies": {
        "@darkgrade/contribute": "workspace:*",
        "pg": "8.16.3"
    },
    "devDependencies": {
        "@types/node": "20.19.43",
        "@types/pg": "8.15.6"
    }
}
