{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM"],
        "jsx": "react-jsx",
        "types": ["w3c-web-usb", "node"],
        "declaration": true,
        "declarationMap": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "./dist",
        "rootDir": ".",
        "baseUrl": ".",
        "paths": {
            "@contribute/*": ["src/contribute/*"],
            "@workflows/*": ["src/workflows/*"],
            "@camera/*": ["src/camera/*"],
            "@core/*": ["src/core/*"],
            "@transport/*": ["src/transport/*"],
            "@ptp/*": ["src/ptp/*"],
            "@vendors/*": ["src/vendors/*"],
            "@runtime/*": ["src/runtime/*"],
            "@cli/*": ["src/cli/*"],
            "@tests/*": ["tests/*"]
        }
    },
    "include": ["src", "tests", "scripts/recover-camera.ts", "scripts/camera-lease.ts", "scripts/camera-smoke", "scripts/check-guards.ts", "*.config.ts"],
    "exclude": ["tests/runtime"]
}
