{
    "name": "@darkgrade/slate",
    "version": "0.1.0",
    "type": "module",
    "description": "Connect to & control your camera via PTP with 2 lines of TypeScript",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/darkgrade/darkgrade.git",
        "directory": "packages/slate"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./cli": {
            "types": "./dist/cli/index.d.ts",
            "import": "./dist/cli/index.mjs",
            "require": "./dist/cli/index.cjs"
        },
        "./controls": {
            "types": "./dist/controls.d.ts",
            "import": "./dist/controls.mjs",
            "require": "./dist/controls.cjs"
        },
        "./protocol": {
            "types": "./dist/protocol.d.ts",
            "import": "./dist/protocol.mjs",
            "require": "./dist/protocol.cjs"
        },
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "browser": {
                "import": "./dist/runtime/browser.mjs",
                "require": "./dist/runtime/browser.cjs"
            },
            "import": "./dist/runtime/index.mjs",
            "require": "./dist/runtime/index.cjs"
        },
        "./runtime/browser": {
            "types": "./dist/runtime/browser.d.ts",
            "import": "./dist/runtime/browser.mjs",
            "require": "./dist/runtime/browser.cjs"
        },
        "./runtime/mcp": {
            "types": "./dist/runtime/mcp.d.ts",
            "import": "./dist/runtime/mcp.mjs",
            "require": "./dist/runtime/mcp.cjs"
        },
        "./runtime/ownership": {
            "types": "./dist/runtime/ownership.d.ts",
            "import": "./dist/runtime/ownership.mjs",
            "require": "./dist/runtime/ownership.cjs"
        },
        "./contribute": {
            "types": "./dist/contribute/index.d.ts",
            "import": "./dist/contribute/index.mjs",
            "require": "./dist/contribute/index.cjs"
        },
        "./contribute/application": {
            "types": "./dist/contribute/application.d.ts",
            "import": "./dist/contribute/application.mjs",
            "require": "./dist/contribute/application.cjs"
        },
        "./contribute/batch": {
            "types": "./dist/contribute/batch.d.ts",
            "import": "./dist/contribute/batch.mjs",
            "require": "./dist/contribute/batch.cjs"
        },
        "./contribute/installation-store": {
            "types": "./dist/contribute/installation-store.d.ts",
            "import": "./dist/contribute/installation-store.mjs",
            "require": "./dist/contribute/installation-store.cjs"
        },
        "./contribute/node": {
            "types": "./dist/contribute/node.d.ts",
            "import": "./dist/contribute/node.mjs",
            "require": "./dist/contribute/node.cjs"
        },
        "./contribute/protocol": {
            "types": "./dist/contribute/protocol.d.ts",
            "import": "./dist/contribute/protocol.mjs",
            "require": "./dist/contribute/protocol.cjs"
        },
        "./contribute/schema": {
            "types": "./dist/contribute/schema.d.ts",
            "import": "./dist/contribute/schema.mjs",
            "require": "./dist/contribute/schema.cjs"
        },
        "./contribute/settings": {
            "types": "./dist/contribute/settings.d.ts",
            "import": "./dist/contribute/settings.mjs",
            "require": "./dist/contribute/settings.cjs"
        },
        "./tsconfig.base.json": "./tsconfig.base.json",
        "./telemetry": {
            "types": "./dist/contribute/application.d.ts",
            "import": "./dist/contribute/application.mjs",
            "require": "./dist/contribute/application.cjs"
        },
        "./telemetry/application": {
            "types": "./dist/contribute/application.d.ts",
            "import": "./dist/contribute/application.mjs",
            "require": "./dist/contribute/application.cjs"
        },
        "./telemetry/batch": {
            "types": "./dist/contribute/batch.d.ts",
            "import": "./dist/contribute/batch.mjs",
            "require": "./dist/contribute/batch.cjs"
        },
        "./telemetry/installation-store": {
            "types": "./dist/contribute/installation-store.d.ts",
            "import": "./dist/contribute/installation-store.mjs",
            "require": "./dist/contribute/installation-store.cjs"
        },
        "./telemetry/node": {
            "types": "./dist/contribute/node.d.ts",
            "import": "./dist/contribute/node.mjs",
            "require": "./dist/contribute/node.cjs"
        },
        "./telemetry/protocol": {
            "types": "./dist/contribute/protocol.d.ts",
            "import": "./dist/contribute/protocol.mjs",
            "require": "./dist/contribute/protocol.cjs"
        },
        "./telemetry/schema": {
            "types": "./dist/contribute/schema.d.ts",
            "import": "./dist/contribute/schema.mjs",
            "require": "./dist/contribute/schema.cjs"
        },
        "./telemetry/settings": {
            "types": "./dist/contribute/settings.d.ts",
            "import": "./dist/contribute/settings.mjs",
            "require": "./dist/contribute/settings.cjs"
        },
        "./telemetry/server": {
            "types": "./dist/telemetry/server/index.d.ts",
            "import": "./dist/telemetry/server/index.js",
            "require": "./dist/telemetry/server/index.js"
        },
        "./telemetry/postgres": {
            "types": "./dist/telemetry/server/postgres.d.ts",
            "import": "./dist/telemetry/server/postgres.js",
            "require": "./dist/telemetry/server/postgres.js"
        }
    },
    "files": [
        "dist",
        "tsconfig.base.json",
        "docs/contribute.md",
        "docs/camera-controls.md",
        "docs/pre-release-audit.md",
        "telemetry/README.md"
    ],
    "scripts": {
        "build": "bun run scripts/generate-camera-operations.ts --compatibility && vite build && tsc -p telemetry/tsconfig.json",
        "dev": "vite build --watch",
        "test": "bun run scripts/test.ts",
        "test:unit": "bun run scripts/test.ts",
        "camera:lease": "bun run scripts/camera-lease.ts",
        "test:fuzz": "vitest run tests/ptp-input-fuzz.test.ts",
        "bench:probe": "bun run tests/bench-probe.ts",
        "bench:profile": "bun run scripts/capture-profile.ts",
        "bench:inspect-recording": "bun run scripts/inspect-recording.ts",
        "bench:ptpip": "bun run tests/bench-ptpip.ts",
        "lint": "eslint . --ext .ts,.tsx",
        "format": "prettier --write .",
        "test:package": "bun run build && bun run scripts/check-package-exports.ts && bun run scripts/check-guards.ts",
        "check:guards": "bun run scripts/check-guards.ts",
        "test:runtime": "bun run build && bun test ./tests/runtime",
        "mcp": "bun run src/runtime/stdio.ts",
        "generate:operations": "bun run scripts/generate-camera-operations.ts",
        "typecheck": "bun run scripts/generate-camera-operations.ts --compatibility && tsc -p tsconfig.json --noEmit && tsc -p tests/runtime/tsconfig.json --noEmit && tsc -p telemetry/tsconfig.json --noEmit",
        "bench:recover": "bun run scripts/recover-camera.ts",
        "test:contribute": "bun run build && node --test tests/contribute/*.test.ts",
        "test:cli": "bun run build && node --test tests/cli/*.test.ts",
        "camera:api-check": "bun run scripts/camera-api-check.ts",
        "camera:parity": "bun run scripts/camera-parity.ts",
        "test:telemetry": "bun run build && node --test tests/telemetry/*.test.ts",
        "telemetry:start": "node dist/telemetry/server/main.js",
        "telemetry:cleanup": "node dist/telemetry/server/operations.js cleanup",
        "telemetry:review": "node dist/telemetry/server/operations.js review",
        "telemetry:export": "node dist/telemetry/server/operations.js export",
        "telemetry:smoke": "node dist/telemetry/server/smoke.js",
        "test:telemetry:postgres": "bun run build && node --test tests/telemetry/postgres.test.ts"
    },
    "keywords": [
        "ptp",
        "picture-transfer-protocol",
        "camera",
        "photography",
        "usb",
        "webusb",
        "nodejs",
        "iso15740"
    ],
    "author": "darkgrade",
    "license": "MIT",
    "dependencies": {
        "@types/node": "^20.11.0",
        "@types/w3c-web-usb": "^1.0.13",
        "egoroof-blowfish": "4.0.3",
        "ink": "^6.3.1",
        "ink-spinner": "^5.0.0",
        "react": "^19",
        "usb": "^2.11.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.3.0",
        "@modelcontextprotocol/server": "2.3.0",
        "@types/bun": "^1.3.14",
        "@types/react": "^19.1.11",
        "vite": "^7.3.7",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.12",
        "zod": "4.6.6",
        "pg": "8.16.3",
        "@types/pg": "8.15.6"
    },
    "engines": {
        "node": ">=22.18"
    },
    "peerDependencies": {
        "@modelcontextprotocol/server": "2.3.0",
        "zod": "4.6.6",
        "pg": "8.16.3"
    },
    "peerDependenciesMeta": {
        "@modelcontextprotocol/server": {
            "optional": true
        },
        "zod": {
            "optional": true
        },
        "pg": {
            "optional": true
        }
    },
    "imports": {
        "#telemetry-server/*": "./dist/telemetry/server/*.js"
    }
}
