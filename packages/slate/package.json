{
    "name": "@darkgrade/slate",
    "version": "0.1.0",
    "type": "module",
    "description": "Connect to & control your camera via PTP with 2 lines of TypeScript",
    "repository": { "type": "git", "url": "git+https://github.com/darkgrade/darkgrade.git", "directory": "packages/slate" },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./cli": {
            "types": "./dist/cli/index.d.ts",
            "import": "./dist/cli/index.mjs",
            "require": "./dist/cli/index.cjs"
        },
        "./controls": {
            "types": "./dist/controls.d.ts",
            "import": "./dist/controls.mjs",
            "require": "./dist/controls.cjs"
        },
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "browser": {
                "import": "./dist/runtime/browser.mjs",
                "require": "./dist/runtime/browser.cjs"
            },
            "import": "./dist/runtime/index.mjs",
            "require": "./dist/runtime/index.cjs"
        },
        "./runtime/browser": {
            "types": "./dist/runtime/browser.d.ts",
            "import": "./dist/runtime/browser.mjs",
            "require": "./dist/runtime/browser.cjs"
        },
        "./runtime/mcp": {
            "types": "./dist/runtime/mcp.d.ts",
            "import": "./dist/runtime/mcp.mjs",
            "require": "./dist/runtime/mcp.cjs"
        },
        "./runtime/ownership": {
            "types": "./dist/runtime/ownership.d.ts",
            "import": "./dist/runtime/ownership.mjs",
            "require": "./dist/runtime/ownership.cjs"
        },
        "./contribute": {
            "types": "./dist/contribute/index.d.ts",
            "import": "./dist/contribute/index.mjs",
            "require": "./dist/contribute/index.cjs"
        },
        "./contribute/application": {
            "types": "./dist/contribute/application.d.ts",
            "import": "./dist/contribute/application.mjs",
            "require": "./dist/contribute/application.cjs"
        },
        "./contribute/batch": {
            "types": "./dist/contribute/batch.d.ts",
            "import": "./dist/contribute/batch.mjs",
            "require": "./dist/contribute/batch.cjs"
        },
        "./contribute/installation-store": {
            "types": "./dist/contribute/installation-store.d.ts",
            "import": "./dist/contribute/installation-store.mjs",
            "require": "./dist/contribute/installation-store.cjs"
        },
        "./contribute/node": {
            "types": "./dist/contribute/node.d.ts",
            "import": "./dist/contribute/node.mjs",
            "require": "./dist/contribute/node.cjs"
        },
        "./contribute/protocol": {
            "types": "./dist/contribute/protocol.d.ts",
            "import": "./dist/contribute/protocol.mjs",
            "require": "./dist/contribute/protocol.cjs"
        },
        "./contribute/schema": {
            "types": "./dist/contribute/schema.d.ts",
            "import": "./dist/contribute/schema.mjs",
            "require": "./dist/contribute/schema.cjs"
        },
        "./contribute/settings": {
            "types": "./dist/contribute/settings.d.ts",
            "import": "./dist/contribute/settings.mjs",
            "require": "./dist/contribute/settings.cjs"
        },
        "./tsconfig.base.json": "./tsconfig.base.json"
    },
    "files": [
        "dist",
        "tsconfig.base.json",
        "docs/contribute.md",
        "docs/camera-controls.md",
        "docs/pre-release-audit.md"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "test": "bun run scripts/test.ts",
        "test:fuzz": "vitest run tests/ptp-input-fuzz.test.ts",
        "bench:probe": "bun run tests/bench-probe.ts",
        "bench:profile": "bun run scripts/capture-profile.ts",
        "bench:inspect-recording": "bun run scripts/inspect-recording.ts",
        "bench:canon": "bun run tests/14_canon.ts",
        "bench:ptpip": "bun run tests/bench-ptpip.ts",
        "lint": "eslint . --ext .ts,.tsx",
        "format": "prettier --write .",
        "test:package": "bun run build && bun run scripts/check-package-exports.ts",
        "test:runtime": "bun run build && bun test ./tests/runtime",
        "mcp": "bun run src/runtime/stdio.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/runtime/tsconfig.json --noEmit",
        "bench:recover": "bun run scripts/recover-camera.ts",
        "test:contribute": "bun run build && node --test tests/contribute/*.test.ts",
        "test:cli": "bun run build && node --test tests/cli/*.test.ts"
    },
    "keywords": [
        "ptp",
        "picture-transfer-protocol",
        "camera",
        "photography",
        "usb",
        "webusb",
        "nodejs",
        "iso15740"
    ],
    "author": "darkgrade",
    "license": "MIT",
    "dependencies": {
        "@types/node": "^20.11.0",
        "@types/w3c-web-usb": "^1.0.13",
        "egoroof-blowfish": "4.0.3",
        "ink": "^6.3.1",
        "ink-spinner": "^5.0.0",
        "react": "^19",
        "usb": "^2.11.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.3.0",
        "@modelcontextprotocol/server": "2.3.0",
        "@types/bun": "^1.3.14",
        "@types/react": "^19.1.11",
        "@vitest/coverage-v8": "^4.1.12",
        "@vitest/ui": "^4.1.12",
        "vite": "^7.3.7",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.12",
        "zod": "4.6.6"
    },
    "engines": {
        "node": ">=22.18"
    },
    "peerDependencies": {
        "@modelcontextprotocol/server": "2.3.0",
        "zod": "4.6.6"
    },
    "peerDependenciesMeta": {
        "@modelcontextprotocol/server": {
            "optional": true
        },
        "zod": {
            "optional": true
        }
    }
}
