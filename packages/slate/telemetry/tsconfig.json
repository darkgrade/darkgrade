{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"],
        "declaration": true,
        "outDir": "../dist/telemetry/server",
        "rootDir": "../src/telemetry/server",
        "paths": {
            "#telemetry-server/*": ["../src/telemetry/server/*.ts"]
        }
    },
    "include": ["../src/telemetry/server/**/*.ts"]
}
