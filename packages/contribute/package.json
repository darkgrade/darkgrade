{
    "name": "@darkgrade/contribute",
    "version": "0.2.0",
    "description": "Consent-controlled, payload-free camera diagnostics for Darkgrade",
    "type": "module",
    "license": "MIT",
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js"
        },
        "./application": {
            "types": "./dist/application.d.ts",
            "import": "./dist/application.js"
        },
        "./batch": {
            "types": "./dist/batch.d.ts",
            "import": "./dist/batch.js"
        },
        "./installation-store": {
            "types": "./dist/installation-store.d.ts",
            "import": "./dist/installation-store.js"
        },
        "./settings": {
            "types": "./dist/settings.d.ts",
            "import": "./dist/settings.js"
        }
    },
    "imports": {
        "#contribute/*": "./dist/*.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test tests/*.test.ts",
        "test:package": "npm run test && npm pack --dry-run"
    },
    "engines": {
        "node": ">=22.18"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "20.19.43"
    }
}
