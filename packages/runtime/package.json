{
    "name": "@darkgrade/runtime",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "Shared camera operations and MCP tools for Darkgrade hosts",
    "exports": {
        ".": "./src/index.ts",
        "./mcp": "./src/mcp.ts",
        "./ownership": "./src/ownership.ts"
    },
    "scripts": {
        "test": "bun test tests",
        "typecheck": "tsc --noEmit",
        "build": "bun build src/index.ts src/mcp.ts src/stdio.ts --outdir dist --target bun --packages external",
        "mcp": "bun run src/stdio.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "2.0.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.0.0",
        "@types/bun": "^1.3.14",
        "@types/node": "^20.11.0",
        "typescript": "5.9.2"
    },
    "engines": {
        "bun": ">=1.4.2"
    }
}
