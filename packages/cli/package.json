{
    "name": "darkgrade",
    "version": "0.1.0-alpha.1",
    "description": "Darkgrade camera diagnostics and telemetry preferences",
    "type": "module",
    "bin": { "darkgrade": "dist/main.js" },
    "files": ["dist", "README.md"],
    "publishConfig": { "tag": "alpha", "access": "public" },
    "scripts": {
        "build": "bun build src/main.ts --target node --format esm --outfile dist/main.js -e usb -e ink -e ink-spinner -e react -e egoroof-blowfish",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test tests/*.test.ts",
        "prepublishOnly": "npm run typecheck && npm test"
    },
    "dependencies": {
        "ink": "^6.3.1",
        "ink-spinner": "^5.0.0",
        "react": "^19",
        "usb": "^2.11.0"
    },
    "devDependencies": {
        "@darkgrade/contribute": "workspace:*",
        "@darkgrade/link": "workspace:*",
        "@types/node": "20.19.43"
    },
    "engines": { "node": ">=22.18" }
}
