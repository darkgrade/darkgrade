    "quirks": [
        {
            "id": "sony-pc-control-usb-pid",
            "description": "Sony bodies enumerate with a different USB PID depending on the camera's USB connection mode: MTP/mass-storage vs \"PC Remote\"/\"PC Control\". Only the PC-Control PID exposes the SDIO control ops. Examples: A7 IV MTP 0x0DA6 vs PC Control 0x0DA7; A7S III 0x0D17 vs 0x0D18; A6600 0x0D0F vs 0x0D10; A7 V MTP 0x0F50 vs PC Control 0x0F56; ZV-1 0x0C1B vs 0x0C44.",
            "source": 2,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "sony-sdio-connect-handshake",
            "description": "SDK USB control initialization uses ordered SDIO phases 1, 2 and 3 with exact parameters. Missing prerequisite responses and negotiation payloads remain unknown; no firmware behavior is inferred.",
            "source": 6,
            "behaviour": {
                "kind": "requires-sequence",
                "sequence": [
                    { "operation": "0x9201", "parameters": ["0x1", "0x0", "0x0"] },
                    { "operation": "0x9201", "parameters": ["0x2", "0x0", "0x0"] },
                    { "operation": "0x9201", "parameters": ["0x3", "0x0", "0x0"] }
                ],
                "gated": { "from": "0x9200", "to": "0x92ff", "except": ["0x9201", "0x9202", "0x9210", "0x9216"] }
            }
        },
        {
            "id": "sony-all-props-dump",
            "description": "Property state is read as one blob: 0x9209 SDIO_GetAllExtDevicePropInfo returns every property descriptor (libgphoto2 notes ~4 KB); the host re-reads it after 0xC203 DevicePropChanged instead of per-prop GetDevicePropDesc. darkgrade exposes a \"only differences\" flag on 0x9209.",
            "source": 10,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "sony-set-vs-control",
            "description": "Two write paths: 0x9205 SDIO_SetExtDevicePropValue for settings (\"value A\") and 0x9207 SDIO_ControlDevice for button-like controls (\"value B\") such as 0xD2C1 ShutterHalfRelease (S1) and 0xD2C2 ShutterRelease (S2) with value 2=press, 1=release. After connect libgphoto2 sets 0xD25A PriorityMode=1 (application/PC priority) so exposure props are writable from the host.",
            "source": 13,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "sony-object-in-memory",
            "description": "Captured images to host are exposed as transient object handle 0xFFFFC001 when DPC 0xD215 ObjectInMemory >= 0x8000 (0x8001 = one image waiting). DeleteObject is not supported; the host must download it to clear it. Focus achieved is signalled by 0xD213 FocusFound changing (1->2) and 0xC203 events.",
            "source": 18,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "sony-startup-delay",
            "description": "Several bodies need ~3 s after connect before capture works (ZV-E10, ZV-1, RX100M7, A7R IV(A), RX0 II, A7 III, A7S III, A7 IV, A7 V, A9 II, A1, A7C); no event signals readiness.",
            "source": 22,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "sony-ptpip-vendor-id",
            "description": "Over PTP/IP Sony reports VendorExtensionID MTP with Manufacturer \"Sony Corporation\"; libgphoto2 remaps to Sony (0x11, first observed on A900).",
            "source": 24,
            "behaviour": {
                "kind": "ptp-ip-personality",
                "port": 15740,
                "vendorExtensionId": "0xffffffff",
                "manufacturer": "Sony Corporation"
            }
        },
        {
            "id": "sony-sdk-access-auth",
            "description": "Network remote on newer bodies (e.g. α6700) can require Access Authentication (SSH-protected); handled in darkgrade by the sony-authenticated-remote skill / SonyRemoteSdkTransport.",
            "source": 26,
            "behaviour": { "kind": "none" },
            "unverified": true
        },
        {
            "id": "sony-legacy-ptp-shared-pid",
            "description": "Pre-2012 Sony DSC/NEX/SLT bodies in \"PTP mode\" share PID 0x004E (generic) or per-model PIDs and expose standard PTP download only (no SDIO control).",
            "source": 27,
            "behaviour": { "kind": "none" }
        }
    ]
