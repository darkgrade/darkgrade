        {
            "id": "leica-le-session",
            "description": "Leica remote control requires 0x9005 LEOpenSession (one arg, 0 accepted) after the standard OpenSession, and 0x9006 LECloseSession on exit; DeviceInfo is re-read after LEOpenSession. Release via 0x9004 LEReleaseStages (1 = AF press, 2 = release, 0x0C/0x0D continuous), 0x9016 LEControlAutoFocus, 0x9019 bulb, 0x901C photo live view, 0x901D keep-alive.",
            "source": 4,
            "behaviour": { "kind": "none" }
        },
