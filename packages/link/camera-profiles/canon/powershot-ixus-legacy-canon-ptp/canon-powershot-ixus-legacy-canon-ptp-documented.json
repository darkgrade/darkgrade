    "quirks": [
        {
            "id": "canon-powershot-legacy-ptp",
            "description": "Pre-EOS-protocol PowerShot/IXUS bodies use the original Canon 0x90xx extension: 0x9008 InitiateReleaseControl / 0x9009 TerminateReleaseControl to enter remote capture, 0x900B/0x900C ViewfinderOn/Off, 0x901D GetViewfinderImage, 0x901A InitiateCaptureInMemory, and 0x9013 CheckEvent polling; 0x9020 GetChanges for property change lists.",
            "source": 2,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "canon-powershot-shared-pids",
            "description": "Regional variants share one USB PID (e.g. Digital IXUS 400 / PowerShot S400 = 0x3075; EOS 400D / Rebel XTi / Kiss Digital X = 0x3110). Model must be taken from DeviceInfo.Model, not the PID.",
            "source": 6,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "canon-ptp-mode-vs-normal-mode",
            "description": "Older Canons exposed PTP only when the camera's USB comms setting was \"PTP\" (table entries say \"(PTP mode)\"); otherwise they used Canon's proprietary protocol served by the separate canon camlib.",
            "source": 8,
            "behaviour": { "kind": "none" },
            "unverified": true
        },
        {
            "id": "canon-delete-sends-event",
            "description": "Older Canon PowerShot/EOS entries carry PTPBUG_DELETE_SENDS_EVENT: after DeleteObject the camera emits an ObjectRemoved event that the host must consume.",
            "source": 9,
            "behaviour": { "kind": "emit-event", "afterOperation": "0x100b", "event": "0x4003", "copyParameters": true }
        }
    ]
