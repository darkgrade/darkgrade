        {
            "id": "sigma-fp-vendor-id",
            "description": "fp reports VendorExtensionID Microsoft; libgphoto2 assigns internal 0xFFFB (GP_SIGMAFP) when VID is 0x1003.",
            "source": 2,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "sigma-fp-checksummed-datagroups",
            "description": "Sigma vendor ops exchange small \"data group\" packets with a length-prefix byte and an additive checksum byte (e.g. 0x901B Snap sends [0x02, mode, amount, 0x02+mode+amount]). Settings via 0x9012-0x9018 Get/SetDataGroup1-3, 0x9023-0x902A groups 4-6, status 0x9011/0x902C, capture status 0x9015 (status & 0xF000: 0x6000 = failure, 0x8000 = success), live view 0x902B GetCamViewFrame.",
            "source": 4,
            "behaviour": { "kind": "none" }
        },
