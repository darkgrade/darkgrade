    "quirks": [
        {
            "id": "olympus-omd-vendor-id",
            "description": "OM-D/OM System bodies identify by Manufacturer \"OLYMPUS\" or \"OMSYSTEM\" and Model starting \"E-M\"/\"OM-\"; libgphoto2 assigns internal vendor id 0xFFFD (GP_OLYMPUS_OMD). OM-1 Mark II enumerates with new VID 0x33A2 (OM Digital Solutions) but same PID 0x0136 as OM-1.",
            "source": 2,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "olympus-omd-pc-mode",
            "description": "Host must switch DPC 0xD052 CameraControlMode to 1 (PC mode) via SetDevicePropValue, then wait ~100 ms and drain events before the body accepts control.",
            "source": 4,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "olympus-omd-capture-0x9481",
            "description": "Capture = 0x9481 OMD_Capture(0x3) (press) then 0x9481(0x6) (release), then 0x9486 query changed props. For bulb, press/release are separated. Errors are returned as RC OK with Param1 carrying a 0x2xxx code ((Param1 & 0x7000)==0x2000).",
            "source": 6,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "olympus-omd-prop-announce-and-poll",
            "description": "Host announces the 16-bit props it wants to monitor with 0x9489 SetProperties (count + list) and 0x948B SetProperties2; then polls 0x9486 ChangedProperties (heavy, ~42 propdescs) or 0x948A PollProperties (light) which return standard PropDesc datasets for changed props (32-bit count, 0 if none).",
            "source": 8,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "olympus-omd-liveview",
            "description": "Live view via 0x9484 GetLiveViewImage; magnify via 0x9483/0x9488; MF drive 0x9487; capture target DPC 0xD0DC.",
            "source": 11,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "olympus-shared-pids",
            "description": "Several OM-D bodies share PIDs (E-M5 II, E-M1 II and E-M1 all 0x0130).",
            "source": 13,
            "behaviour": { "kind": "none" }
        },
        {
            "id": "vendor-opcode-overlap",
            "description": "Olympus 0x9101 = Capture (E-series) while Canon EOS 0x9101 = GetStorageIDs and Panasonic 0x9101 is a different op: opcodes in 0x9xxx are only meaningful per vendor.",
            "source": 14,
            "behaviour": { "kind": "none" }
        }
    ]
